<Project Sdk="Microsoft.NET.Sdk">
  <!-- Original redline-track adapter. Docxodus is referenced from a separately provisioned,
       clean checkout passed as DocxodusRoot; no renderer source is copied into this repository. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DocxBenchRedline</AssemblyName>
    <RootNamespace>DocxBenchRedline</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(DocxodusRoot)/Docxodus/Docxodus.csproj" />
  </ItemGroup>
</Project>
